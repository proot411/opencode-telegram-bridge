{
  "name": "opencode-telegram-bridge",
  "version": "0.1.0",
  "description": "OpenCode plugin that bridges a Telegram bot to an agent session: approve permissions, answer questions, and exchange messages.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:test": "tsc -p tsconfig.json --noEmit false --outDir test-dist || true",
    "test:harness": "npm run build:test && node test/harness.mjs"
  },
  "dependencies": {
    "@opencode/client": "2.0.32"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.32"
  }
}
